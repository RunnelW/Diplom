@model IEnumerable<Diplom.Models.WoodStack>
@{
    ViewData["Title"] = "Панель управления";
    
    // Фильтруем штабеля с нулевым объёмом
    var nonZeroStacks = Model.Where(s => s.CurrentVolume > 0).ToList();
    var recentMovements = ViewBag.RecentMovements as List<Diplom.Models.WoodMovement> ?? new List<Diplom.Models.WoodMovement>();
    var todayIncome = ViewBag.TodayIncome as decimal? ?? 0;
    var totalWood = nonZeroStacks.Sum(s => s.CurrentVolume);
    var lowStacks = nonZeroStacks.Where(s => s.CurrentVolume < 10 && s.CurrentVolume > 0).ToList();
}

<!-- Уведомления -->
@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}
@if (lowStacks.Any())
{
    <div class="alert alert-warning">
        <strong>⚠️ Внимание! Критические остатки:</strong>
        @foreach (var stack in lowStacks)
        {
            <span class="warning-badge">@stack.WoodType (@stack.CurrentVolume.ToString("F1") м³)</span>
        }
    </div>
}

<div class="dashboard-grid">
    <!-- ЛЕВАЯ КОЛОНКА: ДИАГРАММА -->
    <div class="card">
        <div class="card-header">
            <h3>🌲 Остатки древесины</h3>
        </div>
        <div class="card-body">
            <canvas id="woodStacksChart" style="max-height: 260px; width: 100%;"></canvas>
            <div class="chart-legend">
                @foreach (var stack in nonZeroStacks.OrderByDescending(s => s.CurrentVolume))
                {
                    var percent = totalWood > 0 ? (stack.CurrentVolume / totalWood) * 100 : 0;
                    <div class="legend-item">
                        <span class="legend-dot" style="background: @GetColor(stack.WoodType);"></span>
                        <span class="legend-name">@stack.WoodType</span>
                        <span class="legend-value">@stack.CurrentVolume.ToString("F1") м³</span>
                        <span class="legend-percent">(@percent.ToString("F0")%)</span>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- ПРАВАЯ КОЛОНКА: СВОДНАЯ ИНФОРМАЦИЯ -->
    <div class="card">
        <div class="card-header">
            <h3>📊 Сводная информация</h3>
        </div>
        <div class="card-body">
            <div class="total-card">
                <div class="total-label">Общий объём</div>
                <div class="total-value">@totalWood.ToString("F2") м³</div>
            </div>
            <div class="stats-list">
                @foreach (var stack in nonZeroStacks.OrderByDescending(s => s.CurrentVolume))
                {
                    var percent = totalWood > 0 ? (stack.CurrentVolume / totalWood) * 100 : 0;
                    <div class="stat-row">
                        <div class="stat-name">@stack.WoodType</div>
                        <div class="stat-volume">@stack.CurrentVolume.ToString("F1") м³</div>
                        <div class="progress-container">
                            <div class="progress-fill" style="width: @percent.ToString("F0")%; background: @GetColor(stack.WoodType);"></div>
                            <span class="progress-text">@percent.ToString("F0")%</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- БЫСТРЫЙ ПРИХОД -->
<div class="card" style="margin-top: 24px;">
    <div class="card-header">
        <h3>⚡ Быстрый приход</h3>
    </div>
    <div class="card-body">
        <form method="post" action="/WoodMovements/QuickIncome" class="quick-form">
            @Html.AntiForgeryToken()
            <select name="woodType" class="form-control" required>
                <option value="">-- Выберите тип --</option>
                @foreach (var stack in nonZeroStacks.OrderBy(s => s.WoodType))
                {
                    <option value="@stack.WoodType">@stack.WoodType (@stack.CurrentVolume.ToString("F1") м³)</option>
                }
            </select>
            <input type="text" name="supplier" class="form-control" placeholder="Поставщик" />
            <input type="number" step="0.01" name="volume" class="form-control" placeholder="Объём (м³)" required />
            <button type="submit" class="btn-primary">➕ Добавить</button>
        </form>
        <div class="quick-link">
            <a href="/WoodMovements/Income">🔧 Полная форма прихода →</a>
        </div>
    </div>
</div>

<!-- ПОСЛЕДНИЕ ДВИЖЕНИЯ -->
<div class="card" style="margin-top: 24px;">
    <div class="card-header" style="display: flex; justify-content: space-between;">
        <h3>🔄 Последние движения</h3>
        <a href="/WoodMovements" class="link-all">Все движения →</a>
    </div>
    <div class="card-body" style="padding: 0;">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Дата</th>
                    <th>Тип</th>
                    <th>Древесина</th>
                    <th>Объём</th>
                </tr>
            </thead>
            <tbody>
                @if (!recentMovements.Any())
                {
                    <tr>
                        <td colspan="4" class="empty-text">Нет движений</td>
                    </tr>
                }
                else
                {
                    @foreach (var m in recentMovements.Take(5))
                    {
                        <tr>
                            <td>@m.MovementDate.ToString("dd.MM HH:mm")</td>
                            <td>@(m.MovementType == "Income" ? "➕ Приход" : "➖ Расход")</td>
                            <td>@(m.WoodStack?.WoodType ?? "—")</td>
                            <td>@m.Volume.ToString("F2") м³</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    private string GetColor(string woodType)
    {
        switch (woodType)
        {
            case "Берёза": return "#2d6a4f";
            case "Сосна": return "#40916c";
            case "Ель": return "#52b788";
            case "Дуб": return "#74c69d";
            case "Лиственница": return "#95d5b2";
            default: return "#2d6a4f";
        }
    }
}

<style>
    .dashboard-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    .card {
        background: white;
        border-radius: 20px;
        border: 1px solid #e2e8f0;
        overflow: hidden;
    }

    .card-header {
        padding: 16px 20px;
        background: #f8fafc;
        border-bottom: 1px solid #e2e8f0;
    }

    .card-header h3 {
        margin: 0;
        font-size: 16px;
        font-weight: 600;
        color: #1e2a3a;
    }

    .card-body {
        padding: 20px;
    }

    .total-card {
        background: linear-gradient(135deg, #1e2a3a 0%, #2a3a4a 100%);
        border-radius: 16px;
        padding: 20px;
        text-align: center;
        margin-bottom: 20px;
    }

    .total-label {
        font-size: 13px;
        color: #8a9bb0;
        display: block;
    }

    .total-value {
        font-size: 32px;
        font-weight: 700;
        color: white;
        display: block;
    }

    .stats-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .stat-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
    }

    .stat-name {
        width: 100px;
        font-weight: 600;
        color: #1e2a3a;
    }

    .stat-volume {
        width: 70px;
        text-align: right;
        font-family: monospace;
        color: #64748b;
    }

    .progress-container {
        flex: 1;
        background: #e2e8f0;
        border-radius: 20px;
        height: 28px;
        position: relative;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        border-radius: 20px;
    }

    .progress-text {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        font-size: 11px;
        font-weight: 700;
        color: #1e2a3a;
        text-shadow: 0 0 2px white;
    }

    .chart-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 12px 20px;
        margin-top: 20px;
        padding-top: 16px;
        border-top: 1px solid #e2e8f0;
    }

    .legend-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
    }

    .legend-dot {
        width: 12px;
        height: 12px;
        border-radius: 3px;
    }

    .legend-name {
        font-weight: 600;
        color: #1e2a3a;
    }

    .legend-value {
        color: #64748b;
        font-family: monospace;
    }

    .legend-percent {
        color: #2d6a4f;
    }

    .quick-form {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        align-items: flex-end;
    }

    .quick-form .form-control {
        flex: 1;
        min-width: 120px;
        padding: 8px 12px;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
    }

    .btn-primary {
        background: #2d6a4f;
        color: white;
        border: none;
        padding: 8px 20px;
        border-radius: 10px;
        cursor: pointer;
    }

    .btn-primary:hover {
        background: #1b4332;
    }

    .quick-link {
        text-align: right;
        margin-top: 12px;
        padding-top: 12px;
        border-top: 1px solid #e2e8f0;
    }

    .quick-link a {
        color: #2d6a4f;
        font-size: 13px;
        text-decoration: none;
    }

    .link-all {
        color: #2d6a4f;
        font-size: 13px;
        text-decoration: none;
    }

    .data-table {
        width: 100%;
        border-collapse: collapse;
    }

    .data-table th {
        background: #f8fafc;
        padding: 12px;
        text-align: left;
        font-weight: 600;
        color: #1e2a3a;
        border-bottom: 1px solid #e2e8f0;
    }

    .data-table td {
        padding: 10px 12px;
        border-bottom: 1px solid #e2e8f0;
    }

    .empty-text {
        text-align: center;
        padding: 40px;
        color: #94a3b8;
    }

    .alert-success {
        background: #d1e7dd;
        color: #0a3622;
        padding: 12px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        padding: 12px;
        border-radius: 12px;
        margin-bottom: 20px;
    }

    .alert-warning {
        background: #fff3cd;
        color: #856404;
        padding: 12px;
        border-radius: 12px;
        margin-bottom: 20px;
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .warning-badge {
        background: #ffc107;
        color: #1e2a3a;
        padding: 4px 12px;
        border-radius: 20px;
        font-size: 12px;
    }

    @@media (max-width: 768px) {
        .dashboard-grid {
            grid-template-columns: 1fr;
        }

        .quick-form {
            flex-direction: column;
        }

        .quick-form .btn-primary {
            width: 100%;
        }

        .stat-name {
            width: 80px;
        }
    }
</style>

<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const stacks = @Html.Raw(Json.Serialize(nonZeroStacks.Select(s => new { s.WoodType, s.CurrentVolume })));
        if (stacks.length === 0) return;

        function getColor(woodType) {
            switch (woodType) {
                case 'Берёза': return '#2d6a4f';
                case 'Сосна': return '#40916c';
                case 'Ель': return '#52b788';
                case 'Дуб': return '#74c69d';
                case 'Лиственница': return '#95d5b2';
                default: return '#2d6a4f';
            }
        }

        const ctx = document.getElementById('woodStacksChart').getContext('2d');

        new Chart(ctx, {
            type: 'doughnut',
            data: {
                labels: stacks.map(s => s.woodType),
                datasets: [{
                    data: stacks.map(s => s.currentVolume),
                    backgroundColor: stacks.map(s => getColor(s.woodType)),
                    borderWidth: 0,
                    hoverOffset: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: true,
                cutout: '60%',
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        callbacks: {
                            label: function(context) {
                                const total = stacks.reduce((sum, s) => sum + s.currentVolume, 0);
                                const value = context.raw;
                                const percent = ((value / total) * 100).toFixed(1);
                                return `${context.label}: ${value.toFixed(2)} м³ (${percent}%)`;
                            }
                        }
                    }
                }
            }
        });
    });
</script>