@{
    ViewData["Title"] = "Вход в систему";
    Layout = null;
}

<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Фанерный завод</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', 'Inter', system-ui, sans-serif;
            background: linear-gradient(135deg, #0f2b1f 0%, #1a3a2a 50%, #0d2818 100%);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-container {
            width: 100%;
            max-width: 420px;
        }

        .login-card {
            background: white;
            border-radius: 28px;
            padding: 44px 36px;
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.3);
            animation: fadeInUp 0.5s ease-out;
        }

        @@keyframes fadeInUp {
            from

        {
            opacity: 0;
            transform: translateY(20px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }

        }

        .logo {
            text-align: center;
            margin-bottom: 36px;
        }

        .logo-icon {
            font-size: 52px;
            margin-bottom: 12px;
        }

        .logo h1 {
            font-size: 24px;
            font-weight: 700;
            color: #1a3a2a;
            margin-bottom: 6px;
        }

        .logo p {
            font-size: 13px;
            color: #64748b;
        }

        .form-group {
            margin-bottom: 24px;
        }

            .form-group label {
                display: block;
                font-weight: 600;
                font-size: 13px;
                color: #1e2a3a;
                margin-bottom: 8px;
            }

        .input-wrapper {
            position: relative;
            width: 100%;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
            font-size: 18px;
            pointer-events: none;
        }

        .form-control {
            width: 100%;
            padding: 12px 16px 12px 44px;
            font-size: 14px;
            border: 1.5px solid #e2e8f0;
            border-radius: 14px;
            background: #f8fafc;
            transition: all 0.2s;
        }

            .form-control:focus {
                outline: none;
                border-color: #2d6a4f;
                background: white;
                box-shadow: 0 0 0 3px rgba(45, 106, 79, 0.1);
            }

        .btn-login {
            width: 100%;
            padding: 13px;
            background: linear-gradient(135deg, #2d6a4f 0%, #1b4332 100%);
            color: white;
            border: none;
            border-radius: 14px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            margin-top: 8px;
        }

            .btn-login:hover {
                transform: translateY(-2px);
                box-shadow: 0 8px 20px rgba(45, 106, 79, 0.3);
                background: linear-gradient(135deg, #1b4332 0%, #0d2818 100%);
            }

        .alert-danger {
            background: #fef2f2;
            border-left: 4px solid #dc2626;
            padding: 12px 16px;
            border-radius: 12px;
            margin-bottom: 24px;
            font-size: 13px;
            color: #991b1b;
        }

        .footer {
            text-align: center;
            margin-top: 32px;
            font-size: 11px;
            color: #94a3b8;
        }

        /* Убираем autofill фон */
        input:-webkit-autofill,
        input:-webkit-autofill:focus {
            transition: background-color 0s 600000s, color 0s 600000s;
        }
    </style>
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="logo">
                <div class="logo-icon">🌲</div>
                <h1>Фанерный завод</h1>
                <p>пгт. Демьяново</p>
            </div>

            @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
            {
                <div class="alert-danger">
                    @ViewData.ModelState[string.Empty].Errors[0].ErrorMessage
                </div>
            }

            <form method="post">
                @Html.AntiForgeryToken()

                <div class="form-group">
                    <label>Email</label>
                    <div class="input-wrapper">
                        <span class="input-icon">📧</span>
                        <input type="email" name="email" class="form-control" placeholder="Email" required autofocus />
                    </div>
                </div>

                <div class="form-group">
                    <label>Пароль</label>
                    <div class="input-wrapper">
                        <span class="input-icon">🔒</span>
                        <input type="password" name="password" class="form-control" placeholder="••••••••" required />
                    </div>
                </div>

                <button type="submit" class="btn-login">Войти в систему →</button>
            </form>

            <div class="footer">
                © @DateTime.Now.Year Автоматизированная система управления
            </div>
        </div>
    </div>
</body>
</html>