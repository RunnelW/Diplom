@model IEnumerable<Diplom.Models.Inventory>
@{
    ViewData["Title"] = "Инвентаризации";
}

<div class="page-header">
    <h2>📋 Инвентаризации</h2>
    <a href="/Inventory/Create" class="btn-primary">➕ Новая инвентаризация</a>
</div>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="data-table">
    <thead>
        <tr>
            <th>№</th>
            <th>Тип</th>
            <th>Дата начала</th>
            <th>Дата завершения</th>
            <th>Статус</th>
            <th>Кто создал</th>
            <th>Действия</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var inv in Model)
        {
            <tr>
                <td><strong>@inv.InventoryNumber</strong></td>
                <td>@(inv.InventoryType == "WoodStack" ? "🌲 Штабеля (сырьё)" : "📦 Готовая продукция")</td>
                <td>@inv.StartDate.ToString("dd.MM.yyyy HH:mm")</td>
                <td>@(inv.EndDate?.ToString("dd.MM.yyyy HH:mm") ?? "—")</td>
                <td>
                    @if (inv.Status == "В процессе")
                    {
                        <span class="badge badge-warning">🟡 В процессе</span>
                    }
                    else
                    {
                        <span class="badge badge-success">🟢 Завершена</span>
                    }
                </td>
                <td>@(inv.CreatedByUser?.FullName ?? inv.CreatedByUser?.UserName)</td>
                <td class="action-buttons">
                    @if (inv.Status == "В процессе")
                    {
                        <a href="/Inventory/Edit/@inv.Id" class="btn-action btn-edit">✏️ Ввод остатков</a>
                        <a href="/Inventory/EditInventory/@inv.Id" class="btn-action btn-edit">✏️ Изменить</a>
                    }
                    <a href="/Inventory/Results/@inv.Id" class="btn-action btn-details">📄 Результаты</a>
                    <form method="post" action="/Inventory/Delete/@inv.Id" style="display:inline;" onsubmit="return confirm('Удалить инвентаризацию?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-action btn-delete">🗑️ Удалить</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<style>
    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }
    .btn-primary {
        background: #2d6a4f;
        color: white;
        padding: 8px 20px;
        border-radius: 8px;
        text-decoration: none;
        display: inline-block;
        transition: all 0.2s;
    }
    .btn-primary:hover {
        background: #1b4332;
        transform: translateY(-1px);
    }
    .alert-success {
        background: #d1e7dd;
        color: #0a3622;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .alert-danger {
        background: #f8d7da;
        color: #721c24;
        padding: 12px;
        border-radius: 8px;
        margin-bottom: 20px;
    }
    .data-table {
        width: 100%;
        border-collapse: collapse;
        background: white;
        border-radius: 12px;
        overflow: hidden;
    }
    .data-table th {
        background: #1e2a3a;
        color: white;
        padding: 12px;
        text-align: left;
    }
    .data-table td {
        padding: 10px 12px;
        border-bottom: 1px solid #e2e8f0;
    }
    .action-buttons {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
    }
    .btn-action {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 500;
        text-decoration: none;
        transition: all 0.2s;
        cursor: pointer;
        border: none;
    }
    .btn-edit {
        background: #0d6efd;
        color: white;
    }
    .btn-delete {
        background: #dc3545;
        color: white;
    }
    .btn-details {
        background: #6c757d;
        color: white;
    }
    .badge-warning {
        background: #fff3cd;
        color: #856404;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
    }
    .badge-success {
        background: #d1e7dd;
        color: #0a3622;
        padding: 4px 10px;
        border-radius: 20px;
        font-size: 12px;
    }
</style>